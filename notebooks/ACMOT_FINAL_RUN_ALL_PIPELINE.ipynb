{"cells":[{"cell_type":"markdown","metadata":{},"source":["# AC-MOT Final Run-All Pipeline\n","\n","Run All order: official TrackEval for 3 replay finalists -> automatic winner selection -> local dataset staging -> final T4 FP16 live benchmark for the winner -> official TrackEval on final live predictions.\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["from pathlib import Path\n","from datetime import datetime\n","import os, sys, json, shutil, subprocess, time, math\n","\n","ALLOW_LIVE_RUN = True\n","REPO_URL = 'https://github.com/AhmedCode110/ACMOT-Codex-V10Style-Portable.git'\n","REPO = Path('/content/ACMOT-Codex-V10Style-Portable')\n","\n","from google.colab import drive\n","drive.mount('/content/drive', force_remount=False)\n","\n","if REPO.exists():\n","    subprocess.run(['git','-C',str(REPO),'pull','--ff-only'], check=False)\n","else:\n","    subprocess.run(['git','clone',REPO_URL,str(REPO)], check=True)\n","os.chdir(REPO)\n","COMMIT = subprocess.check_output(['git','rev-parse','HEAD'], text=True).strip()\n","print('Commit:', COMMIT)\n","print('ALLOW_LIVE_RUN:', ALLOW_LIVE_RUN)\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["subprocess.run([sys.executable,'-m','pip','install','-q','ultralytics==8.3.200','motmetrics','opencv-python-headless','pandas','numpy','scipy','lap','pyyaml','tqdm'], check=True)\n","import numpy as np, pandas as pd\n","for name, value in {'float':float,'int':int,'bool':bool}.items():\n","    if name not in np.__dict__: setattr(np,name,value)\n","print('Dependencies ready')\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Locate exact sweep safely\n","ROOTS = [\n","    Path('/content/drive/MyDrive/VisDrone_Results_SHARED/ACMOT_SWEEPS'),\n","    Path('/content/drive/MyDrive/VisDrone_Results/ACMOT_SWEEPS'),\n","]\n","SWEEP_ROOT = next((p for p in ROOTS if p.exists()), None)\n","if SWEEP_ROOT is None:\n","    raise RuntimeError('ACMOT_SWEEPS not visible in mounted MyDrive')\n","SWEEP_DIR = SWEEP_ROOT / 'master_sweep_20260907_172533'\n","if not SWEEP_DIR.exists():\n","    raise RuntimeError(f'Missing sweep: {SWEEP_DIR}')\n","FINALISTS = ['TRK_MATCH_090','TRK_BUFFER60_NEW22_MATCH88','TRK_NEW24_MATCH88']\n","for t in FINALISTS:\n","    p = SWEEP_DIR/'trial_outputs'/t/'predictions_mot'\n","    print(t, p.exists(), p)\n","    if not p.exists(): raise RuntimeError(f'Missing predictions for {t}: {p}')\n","print('Sweep ready:', SWEEP_DIR)\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Verify dataset and stage GT source path\n","DRIVE_DATASET = Path('/content/drive/MyDrive/visdrone/VisDrone_Zips/VisDrone2019-MOT-test-dev/VisDrone2019-MOT-test-dev')\n","if not (DRIVE_DATASET/'sequences').is_dir() or not (DRIVE_DATASET/'annotations').is_dir():\n","    raise RuntimeError(f'Dataset missing: {DRIVE_DATASET}')\n","seqs = sorted([p.name for p in (DRIVE_DATASET/'sequences').iterdir() if p.is_dir()])\n","anns = {p.stem for p in (DRIVE_DATASET/'annotations').glob('*.txt')}\n","total_frames = sum(len(list((DRIVE_DATASET/'sequences'/s).glob('*.jpg'))) for s in seqs)\n","print('Sequences:', len(seqs), 'Frames:', total_frames)\n","if len(seqs) != 17 or any(s not in anns for s in seqs) or total_frames != 6635:\n","    raise RuntimeError('Dataset is not the final 17-sequence / 6635-frame split')\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Build TrackEval-ready layouts for the 3 replay finalists and run official TrackEval\n","import shutil, re\n","\n","TRACK_EVAL_ROOT = Path('/content/TrackEval')\n","if not (TRACK_EVAL_ROOT/'trackeval'/'__init__.py').exists():\n","    if TRACK_EVAL_ROOT.exists(): shutil.rmtree(TRACK_EVAL_ROOT)\n","    subprocess.run(['git','clone','--depth','1','https://github.com/JonathonLuiten/TrackEval.git',str(TRACK_EVAL_ROOT)], check=True)\n","if str(TRACK_EVAL_ROOT) not in sys.path: sys.path.insert(0, str(TRACK_EVAL_ROOT))\n","import trackeval\n","\n","EVAL_ROOT = SWEEP_DIR/'official_trackeval_finalists'\n","if EVAL_ROOT.exists(): shutil.rmtree(EVAL_ROOT)\n","gt_root = EVAL_ROOT/'trackeval_gt'/'VisDroneACMOT-test'\n","trk_root = EVAL_ROOT/'trackeval_trackers'/'VisDroneACMOT-test'\n","seqmap = EVAL_ROOT/'seqmap.txt'\n","EVAL_ROOT.mkdir(parents=True, exist_ok=True)\n","seqmap.write_text('name\\n'+'\\n'.join(seqs)+'\\n', encoding='utf-8')\n","\n","VISDRONE_GT_CLASSES = [1,4,5,6,9]\n","for seq in seqs:\n","    cols=['frame','id','x','y','w','h','score','cat','trunc','occ']\n","    gt = pd.read_csv(DRIVE_DATASET/'annotations'/f'{seq}.txt', header=None, names=cols)\n","    gt = gt[(gt['cat'].isin(VISDRONE_GT_CLASSES)) & (gt['score']==1) & (gt['occ']<2) & (gt['trunc']<2)]\n","    gtdir = gt_root/seq/'gt'; gtdir.mkdir(parents=True, exist_ok=True)\n","    mot = pd.DataFrame({0:gt['frame'].astype(int),1:gt['id'].astype(int),2:gt['x'],3:gt['y'],4:gt['w'],5:gt['h'],6:1,7:1,8:1})\n","    mot.to_csv(gtdir/'gt.txt', header=False, index=False)\n","    n = len(list((DRIVE_DATASET/'sequences'/seq).glob('*.jpg')))\n","    (gt_root/seq/'seqinfo.ini').write_text(f'[Sequence]\\nname={seq}\\nimDir=img1\\nframeRate=30\\nseqLength={n}\\nimWidth=0\\nimHeight=0\\nimExt=.jpg\\n', encoding='utf-8')\n","\n","for t in FINALISTS:\n","    data = trk_root/t/'data'; data.mkdir(parents=True, exist_ok=True)\n","    src = SWEEP_DIR/'trial_outputs'/t/'predictions_mot'\n","    for seq in seqs:\n","        f = src/f'{seq}.txt'\n","        if not f.exists(): raise RuntimeError(f'Missing {f}')\n","        shutil.copy2(f, data/f.name)\n","\n","eval_config = trackeval.Evaluator.get_default_eval_config()\n","eval_config.update({'USE_PARALLEL':False,'PRINT_RESULTS':True,'PRINT_ONLY_COMBINED':True,'PRINT_CONFIG':False,'OUTPUT_SUMMARY':True,'OUTPUT_DETAILED':True,'PLOT_CURVES':False})\n","dataset_config = trackeval.datasets.MotChallenge2DBox.get_default_dataset_config()\n","dataset_config.update({'GT_FOLDER':str(EVAL_ROOT/'trackeval_gt'),'TRACKERS_FOLDER':str(EVAL_ROOT/'trackeval_trackers'),'TRACKERS_TO_EVAL':FINALISTS,'BENCHMARK':'VisDroneACMOT','SPLIT_TO_EVAL':'test','SEQMAP_FILE':str(seqmap),'DO_PREPROC':False,'TRACKER_SUB_FOLDER':'data','OUTPUT_SUB_FOLDER':'','PRINT_CONFIG':False})\n","metrics_config={'METRICS':['HOTA','CLEAR','Identity'],'THRESHOLD':0.5}\n","evaluator = trackeval.Evaluator(eval_config)\n","dataset_list=[trackeval.datasets.MotChallenge2DBox(dataset_config)]\n","metrics_list=[trackeval.metrics.HOTA(metrics_config),trackeval.metrics.CLEAR(metrics_config),trackeval.metrics.Identity(metrics_config)]\n","_ = evaluator.evaluate(dataset_list, metrics_list)\n","print('Official finalist TrackEval complete')\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Parse official TrackEval summaries and select true winner\n","def parse_summary(path):\n","    lines=[x.strip() for x in path.read_text(errors='replace').splitlines() if x.strip()]\n","    if len(lines)<2: return {}\n","    h=re.split(r'\\s+',lines[0]); v=re.split(r'\\s+',lines[1]); out={}\n","    for k,x in zip(h,v):\n","        try: out[k]=float(x)\n","        except: out[k]=x\n","    return out\n","rows=[]\n","for t in FINALISTS:\n","    merged={}\n","    for p in (trk_root/t).rglob('*_summary.txt'): merged.update(parse_summary(p))\n","    rows.append({'trial':t,'HOTA':float(merged.get('HOTA',np.nan)),'MOTA':float(merged.get('MOTA',np.nan)),'IDF1':float(merged.get('IDF1',np.nan)),'IDS':float(merged.get('IDSW',merged.get('IDs',merged.get('IDS',np.nan))))})\n","official = pd.DataFrame(rows)\n","print(official)\n","if official[['HOTA','MOTA','IDF1','IDS']].isna().any().any():\n","    raise RuntimeError('Could not parse all official metrics')\n","official['balanced'] = 0.45*official['HOTA'] + 0.35*official['IDF1'] + 0.20*official['MOTA']\n","official = official.sort_values(['balanced','HOTA','IDF1','MOTA','IDS'], ascending=[False,False,False,False,True]).reset_index(drop=True)\n","WINNER = str(official.iloc[0]['trial'])\n","official.to_csv(EVAL_ROOT/'OFFICIAL_FINALISTS.csv', index=False)\n","print('TRUE WINNER:', WINNER)\n","print(official)\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Load winner config and verify final live hardware\n","TRIAL_CONFIG = SWEEP_DIR/'trial_outputs'/WINNER/'trial_config.json'\n","trial = json.loads(TRIAL_CONFIG.read_text())\n","print('Winner config:', TRIAL_CONFIG)\n","import torch\n","gpu = torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NO CUDA'\n","print('GPU:', gpu)\n","if not torch.cuda.is_available() or 'T4' not in gpu:\n","    raise RuntimeError('Final live benchmark requires Tesla T4')\n","if not ALLOW_LIVE_RUN:\n","    raise RuntimeError('Set ALLOW_LIVE_RUN=True to execute final live run')\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Stage dataset to local SSD before timing\n","LOCAL_DATASET = Path('/content/VisDrone2019-MOT-test-dev')\n","if not (LOCAL_DATASET/'sequences').is_dir() or not (LOCAL_DATASET/'annotations').is_dir():\n","    if LOCAL_DATASET.exists(): shutil.rmtree(LOCAL_DATASET)\n","    print('Copying dataset to local SSD (outside timing)...')\n","    shutil.copytree(DRIVE_DATASET, LOCAL_DATASET)\n","else:\n","    print('Local dataset already staged')\n","print('Timed dataset:', LOCAL_DATASET)\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Core final live FP16 runner\n","import cv2, yaml\n","from collections import deque\n","from dataclasses import dataclass\n","from types import SimpleNamespace\n","from tqdm.auto import tqdm\n","from ultralytics import YOLO\n","from ultralytics.trackers.byte_tracker import BYTETracker\n","from ultralytics.engine.results import Boxes\n","\n","COCO_CLASSES=[0,2,5,7]\n","@dataclass\n","class SceneState:\n","    sci: float=0.0; scene: str='clear'; tiny_ratio: float=0.0; object_count: int=0\n","class Analyzer:\n","    def __init__(self,cfg): self.cfg=cfg; self.hist=deque(maxlen=int(cfg.get('window',7))); self.last=SceneState()\n","    def reset(self): self.hist.clear(); self.last=SceneState()\n","    def maybe(self,frame,img,prev):\n","        stride=int(self.cfg.get('stride',10))\n","        if frame!=1 and (frame-1)%stride!=0: return self.last\n","        small=cv2.resize(img,None,fx=.25,fy=.25); g=cv2.cvtColor(small,cv2.COLOR_BGR2GRAY)\n","        brightness=float(g.mean()); blur=float(cv2.Laplacian(g,cv2.CV_64F).var()); edge=float(cv2.Canny(g,50,120).mean()/255.0)\n","        n=len(prev); crowd=min(n/float(self.cfg.get('crowd_divisor',30)),1.0)\n","        tiny=float(np.mean(((prev[:,2]-prev[:,0])*(prev[:,3]-prev[:,1]))<32*32)) if n else 0.0\n","        raw=float(self.cfg.get('crowd_w',.30))*crowd+float(self.cfg.get('tiny_w',.30))*tiny+float(self.cfg.get('edge_w',.20))*min(edge/float(self.cfg.get('edge_norm',.14)),1.0)+float(self.cfg.get('night_w',.10))*(brightness<80)+float(self.cfg.get('blur_w',.05))*(blur<180)\n","        self.hist.append(float(np.clip(raw,0,1))); sci=float(np.mean(self.hist))\n","        scene='night' if brightness<80 else 'blur' if blur<180 else 'tiny' if tiny>.50 else 'crowded' if crowd>.65 or edge>.13 else 'clear'\n","        self.last=SceneState(sci,scene,tiny,n); return self.last\n","class Calib:\n","    def __init__(self,cfg): self.cfg=cfg\n","    def params(self,s):\n","        c=float(self.cfg.get('conf_base',.245))-float(self.cfg.get('conf_slope',.050))*s.sci\n","        i=float(self.cfg.get('iou_base',.490))-float(self.cfg.get('iou_slope',.050))*s.sci\n","        if s.scene in ['crowded','tiny','night']: c-=float(self.cfg.get('scene_conf_nudge',.012))\n","        if s.scene=='blur': i-=float(self.cfg.get('blur_iou_nudge',.012))\n","        if self.cfg.get('ids_guard') and s.object_count>25:\n","            c+=float(self.cfg.get('ids_guard_conf_add',.008)); i+=float(self.cfg.get('ids_guard_iou_add',.010))\n","        size=832 if s.sci>float(self.cfg.get('sci_high',.60)) or s.tiny_ratio>float(self.cfg.get('tiny_gate',.50)) else 736 if s.sci>float(self.cfg.get('sci_mid',.35)) or s.scene in ['crowded','tiny'] else 640\n","        return {'imgsz':size,'conf':float(np.clip(c,float(self.cfg.get('conf_floor',.19)),float(self.cfg.get('conf_ceil',.28)))),'iou':float(np.clip(i,float(self.cfg.get('iou_floor',.40)),float(self.cfg.get('iou_ceil',.52))))}\n","def tracker_from(cfg):\n","    return BYTETracker(SimpleNamespace(track_high_thresh=float(cfg.get('high',.18)),track_low_thresh=float(cfg.get('low',.04)),new_track_thresh=float(cfg.get('new',.20)),track_buffer=int(cfg.get('buffer',45)),match_thresh=float(cfg.get('match',.86)),fuse_score=bool(cfg.get('fuse',True))), frame_rate=30)\n","def sync(): torch.cuda.synchronize()\n","print('Live functions ready')\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Execute final live FP16 winner once; processing FPS excludes JPEG decode and storage\n","RUN_DIR = Path('/content/drive/MyDrive/VisDrone_Results/ACMOT_LIVE_FINAL') / f'final_{WINNER}_{datetime.now().strftime("%Y%m%d_%H%M%S")}'\n","PRED = RUN_DIR/'predictions_mot'; PRED.mkdir(parents=True, exist_ok=False)\n","model=YOLO('yolov8n.pt'); actual_fp16=None\n","proc_times=[]; decode_times=[]; size_log=[]\n","for seq in tqdm(seqs, desc=f'LIVE {WINNER}'):\n","    trk=tracker_from(trial['tracker']); ana=Analyzer(trial['sci']); cal=Calib(trial['calib']); ana.reset(); prev=np.empty((0,4)); lines=[]\n","    frames=sorted((LOCAL_DATASET/'sequences'/seq).glob('*.jpg'))\n","    first=cv2.imread(str(frames[0]))\n","    for s in [640,736,832]:\n","        model.predict(first,conf=.19,iou=.45,imgsz=s,classes=COCO_CLASSES,max_det=1000,half=True,device=0,verbose=False)\n","    sync()\n","    for fp in frames:\n","        d0=time.perf_counter(); img=cv2.imread(str(fp)); decode_times.append(time.perf_counter()-d0)\n","        if img is None: raise RuntimeError(f'Unreadable {fp}')\n","        frame_idx=int(fp.stem)\n","        sync(); t0=time.perf_counter()\n","        state=ana.maybe(frame_idx,img,prev) if trial.get('adaptive',True) else SceneState()\n","        prm=cal.params(state) if trial.get('adaptive',True) else {'imgsz':640,'conf':.25,'iou':.45}\n","        r=model.predict(img,conf=float(prm['conf']),iou=float(prm['iou']),imgsz=int(prm['imgsz']),classes=COCO_CLASSES,max_det=1000,half=True,device=0,verbose=False)[0]\n","        sync()\n","        if actual_fp16 is None:\n","            actual_fp16=bool(getattr(getattr(model,'predictor',None).model,'fp16',False)); print('actual_model_fp16:',actual_fp16)\n","            if not actual_fp16: raise RuntimeError('Ultralytics did not report FP16')\n","        arr=r.boxes.data.detach().cpu().numpy() if r.boxes is not None else np.empty((0,6))\n","        arr=np.asarray(arr,dtype=float).reshape(-1,6) if len(arr) else np.empty((0,6))\n","        out=np.asarray(trk.update(Boxes(arr, tuple(img.shape[:2]))),dtype=float).reshape(-1,8) if len(arr) else np.asarray(trk.update(Boxes(np.empty((0,6)), tuple(img.shape[:2]))),dtype=float).reshape(-1,8)\n","        sync(); proc_times.append(time.perf_counter()-t0); size_log.append(int(prm['imgsz']))\n","        if len(out):\n","            ids=out[:,4].astype(int); boxes=out[:,:4]; scores=out[:,5]; prev=boxes.copy()\n","            for tid,b,score in zip(ids,boxes,scores):\n","                x1,y1,x2,y2=b.tolist(); lines.append(f'{frame_idx},{tid},{x1:.2f},{y1:.2f},{x2-x1:.2f},{y2-y1:.2f},{float(score):.6f},-1,-1,-1\\n')\n","        else: prev=np.empty((0,4))\n","    (PRED/f'{seq}.txt').write_text(''.join(lines),encoding='utf-8')\n","PROCESSING_FPS = len(proc_times)/sum(proc_times)\n","END_TO_END_FPS = len(proc_times)/(sum(proc_times)+sum(decode_times))\n","print('Processing FPS:', PROCESSING_FPS)\n","print('Decode-inclusive FPS:', END_TO_END_FPS)\n"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Official TrackEval on the actual final FP16 live predictions\n","LIVE_EVAL = RUN_DIR/'trackeval'\n","gt_root2=LIVE_EVAL/'trackeval_gt'/'VisDroneACMOT-test'; trk_root2=LIVE_EVAL/'trackeval_trackers'/'VisDroneACMOT-test'; seqmap2=LIVE_EVAL/'seqmap.txt'\n","LIVE_EVAL.mkdir(parents=True, exist_ok=True); seqmap2.write_text('name\\n'+'\\n'.join(seqs)+'\\n',encoding='utf-8')\n","for seq in seqs:\n","    cols=['frame','id','x','y','w','h','score','cat','trunc','occ']\n","    gt=pd.read_csv(LOCAL_DATASET/'annotations'/f'{seq}.txt',header=None,names=cols)\n","    gt=gt[(gt['cat'].isin(VISDRONE_GT_CLASSES))&(gt['score']==1)&(gt['occ']<2)&(gt['trunc']<2)]\n","    gtd=gt_root2/seq/'gt'; gtd.mkdir(parents=True,exist_ok=True)\n","    pd.DataFrame({0:gt['frame'].astype(int),1:gt['id'].astype(int),2:gt['x'],3:gt['y'],4:gt['w'],5:gt['h'],6:1,7:1,8:1}).to_csv(gtd/'gt.txt',header=False,index=False)\n","    n=len(list((LOCAL_DATASET/'sequences'/seq).glob('*.jpg'))); (gt_root2/seq/'seqinfo.ini').write_text(f'[Sequence]\\nname={seq}\\nimDir=img1\\nframeRate=30\\nseqLength={n}\\nimWidth=0\\nimHeight=0\\nimExt=.jpg\\n')\n","data2=trk_root2/WINNER/'data'; data2.mkdir(parents=True,exist_ok=True)\n","for seq in seqs: shutil.copy2(PRED/f'{seq}.txt',data2/f'{seq}.txt')\n","ec=trackeval.Evaluator.get_default_eval_config(); ec.update({'USE_PARALLEL':False,'PRINT_RESULTS':True,'PRINT_ONLY_COMBINED':True,'PRINT_CONFIG':False,'OUTPUT_SUMMARY':True,'OUTPUT_DETAILED':True,'PLOT_CURVES':False})\n","dc=trackeval.datasets.MotChallenge2DBox.get_default_dataset_config(); dc.update({'GT_FOLDER':str(LIVE_EVAL/'trackeval_gt'),'TRACKERS_FOLDER':str(LIVE_EVAL/'trackeval_trackers'),'TRACKERS_TO_EVAL':[WINNER],'BENCHMARK':'VisDroneACMOT','SPLIT_TO_EVAL':'test','SEQMAP_FILE':str(seqmap2),'DO_PREPROC':False,'TRACKER_SUB_FOLDER':'data','OUTPUT_SUB_FOLDER':'','PRINT_CONFIG':False})\n","mc={'METRICS':['HOTA','CLEAR','Identity'],'THRESHOLD':0.5}\n","trackeval.Evaluator(ec).evaluate([trackeval.datasets.MotChallenge2DBox(dc)],[trackeval.metrics.HOTA(mc),trackeval.metrics.CLEAR(mc),trackeval.metrics.Identity(mc)])\n","merged={}\n","for p in (trk_root2/WINNER).rglob('*_summary.txt'): merged.update(parse_summary(p))\n","summary={'winner':WINNER,'HOTA':float(merged.get('HOTA',np.nan)),'MOTA':float(merged.get('MOTA',np.nan)),'IDF1':float(merged.get('IDF1',np.nan)),'IDS':float(merged.get('IDSW',merged.get('IDs',merged.get('IDS',np.nan)))),'processing_fps':float(PROCESSING_FPS),'decode_inclusive_fps':float(END_TO_END_FPS),'precision':'FP16','actual_model_fp16':bool(actual_fp16),'gpu':gpu,'frames':len(proc_times),'repo_commit':COMMIT}\n","pd.DataFrame([summary]).to_csv(RUN_DIR/'FINAL_OFFICIAL_SUMMARY.csv',index=False)\n","(RUN_DIR/'FINAL_OFFICIAL_SUMMARY.json').write_text(json.dumps(summary,indent=2))\n","print('\\nFINAL PUBLISHABLE RESULT')\n","print(json.dumps(summary,indent=2))\n","print('Saved:', RUN_DIR)\n"]}],"metadata":{"colab":{"name":"ACMOT_FINAL_RUN_ALL_PIPELINE.ipynb","provenance":[]},"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":5}